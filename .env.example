# ─── AssessAI Environment Configuration Template ─────────────────────────
# Copy this file to .env in development.
# On Vercel, set these as Environment Variables in the dashboard.
# Do NOT put real secrets in this file.

# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────
# Connect to Postgres via the Supabase session pooler on port 5432
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30&pool_timeout=30"

# Direct / session connection URL used for Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30&pool_timeout=30"

# ─── Auth.js (NextAuth v5) ────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=""


# Required in production so Auth.js knows the canonical URL for redirects and reset emails.
# Set to your Vercel deployment URL (e.g. https://assessai.vercel.app) or http://localhost:3000 locally
AUTH_URL="https://assess-ai-delta.vercel.app"

# Required only for controlled instructor registration.
# Set a strong random value in local/Vercel environment variables.
INSTRUCTOR_SIGNUP_CODE=""

# ─── AI Provider (Gemini) ─────────────────────────────────────────────────
# Server-only — NEVER use NEXT_PUBLIC_ prefix for this key.
# Get from: https://aistudio.google.com/app/apikey
AI_PROVIDER="gemini"
AI_MODEL="gemini-2.5-flash"
AI_API_KEY=""
# ─── Email Provider (Resend) ──────────────────────────────────────────────
# Server-only — NEVER use NEXT_PUBLIC_ prefix for this key.
# Get from: https://resend.com/api-keys
RESEND_API_KEY=""

# Must be an address using a domain verified in your Resend account.
# Example: "AssessAI <noreply@your-verified-domain.com>"
EMAIL_FROM="AssessAI <onboarding@resend.dev>"
